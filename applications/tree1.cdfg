# Entity : 3add
source(start_node) {
	targets in1, in2, in3, in4;
}

# Input declaration (4 Inputs for the 2 Adders)
input(in1) { bitwidth 32; signed 1; }
input(in2) { bitwidth 32; signed 1; }
input(in3) { bitwidth 32; signed 1; }
input(in4) { bitwidth 32; signed 1; }

# Entity : 3add_tree
source(start_node) { targets in1, in2, in3, in4; }
input(in1, in2, in3, in4) { bitwidth 32; signed 1; }
output(y) { bitwidth 32; signed 1; }

operation(op0) { function add; read in1, in2; write t1; }
operation(op1) { function add; read in3, in4; write t2; }
operation(op2) { function add; read t1, t2; write y; }

sink(end_node) { targets y; }